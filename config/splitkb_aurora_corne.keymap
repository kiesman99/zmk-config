#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* Rectangle / window management combos on Layer 6 (DevNumRow) */
        combo_rect_max {
            bindings = <&kp LC(LA(ENTER))>;
            key-positions = <3>;
            layers = <6>;
        };

        combo_rect_right {
            bindings = <&kp LC(LA(RIGHT))>;
            key-positions = <4>;
            layers = <6>;
        };

        combo_rect_left {
            bindings = <&kp LC(LA(LEFT))>;
            key-positions = <2>;
            layers = <6>;
        };
    };

    behaviors {
        hrt: hrt {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-caps-word";
            label = "NEW_BEHAVIOR";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS DOT>;
        };

        left_caps_lock_tap_dance: left_caps_lock_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFT_CAPS_LOCK_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };

        right_caps_lock_tap_dance: right_caps_lock_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHT_CAPS_LOCK_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&caps_word>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        closeHtml: closeHtml {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH &kp GT>;
            label = "CLOSEHTML";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            // Base (your current layout, unchanged)
            bindings = <
&kp ESCAPE                 &kp Q                &kp W            &kp F            &kp P              &kp B        &kp J        &kp L               &kp U             &kp Y             &kp SQT       &kp BSPC
&kp LG(SPACE)              &hrt LEFT_CONTROL A  &hrt LEFT_ALT R  &hrt LEFT_GUI S  &hrt LEFT_SHIFT T  &kp G        &kp M        &hrt RIGHT_SHIFT N  &hrt RIGHT_GUI E  &hrt RIGHT_ALT I  &hrt RCTRL O  &kp SQT
&left_caps_lock_tap_dance  &kp Z                &kp X            &kp C            &kp D              &kp V        &kp K        &kp H               &kp COMMA         &kp DOT           &kp FSLH      &right_caps_lock_tap_dance
                                                                 &lt 6 ESCAPE     &lt 4 SPACE        &lt 5 TAB    &lt 2 ENTER  &lt 5 BACKSPACE     &lt 3 DEL
            >;
        };

        QWERTY {
            bindings = <
&trans  &kp Q         &kp W            &kp E            &kp R              &kp T     &kp Y   &kp U               &kp I             &kp O             &kp P                 &trans
&trans  &hrt LCTRL A  &hrt LEFT_ALT S  &hrt LEFT_GUI D  &hrt LEFT_SHIFT F  &kp G     &kp H   &hrt RIGHT_SHIFT J  &hrt RIGHT_GUI K  &hrt RIGHT_ALT L  &hrt RCTRL SEMICOLON  &trans
&trans  &kp Z         &kp X            &kp C            &kp V              &kp B     &kp N   &kp M               &kp COMMA         &kp DOT           &kp FSLH              &trans
                                       &trans           &trans             &trans    &trans  &trans              &trans
            >;
        };

        /* Layer 2: Number (numpad style, normalized to N1..N0) */
        Number {
            bindings = <
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &kp N0      &trans    &trans  &trans  &trans
            >;
        };

        /* Layer 3: Function (unchanged) */
        Function {
            bindings = <
&trans  &kp F13  &kp F7  &kp F8  &kp F9  &trans    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &trans  &trans  &bt BT_CLR
&trans  &kp F12  &kp F4  &kp F5  &kp F6  &trans    &trans         &bt BT_PRV     &bt BT_NXT    &trans  &trans  &bt BT_CLR_ALL
&trans  &kp F11  &kp F1  &kp F2  &kp F3  &trans    &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_SEL 2  &trans  &trans  &trans
                         &trans  &trans  &trans    &trans         &trans         &trans
            >;
        };

        /* Layer 4: Navigation (unchanged) */
        Navigation {
            bindings = <
&trans                    &trans  &trans  &kp LG(X)      &kp LG(C)  &kp LG(V)    &none               &kp PAGE_DOWN   &kp UP_ARROW  &kp PAGE_UP  &none          &none
&trans                    &trans  &trans  &kp LS(LG(Z))  &kp LG(Z)  &kp LG(A)    &kp LA(LEFT_ARROW)  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT    &kp LA(RIGHT)  &trans
&kp LS(LG(LC(NUMBER_4)))  &trans  &trans  &kp LG(X)      &kp LG(C)  &kp LG(V)    &trans              &trans          &trans        &trans       &trans         &trans
                                          &trans         &trans     &trans       &trans              &trans          &trans
            >;
        };

        /*
         * Layer 5: Symbol (patched)
         * - PURE symbols: no home-row hold-taps here (predictable output)
         * - Bracket cluster on right: {} [] ()
         * - Operators grouped: = + - _ * /, plus <> ; : quotes
         */
        Symbol {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH        &kp DOLLAR        &kp PERCENT   &kp CARET   &kp LEFT_BRACE        &kp RIGHT_BRACE       &kp LEFT_BRACKET      &kp RIGHT_BRACKET     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &kp EQUAL        &kp PLUS      &kp MINUS       &kp UNDERSCORE    &kp ASTERISK  &kp SLASH   &kp LESS_THAN         &kp GREATER_THAN      &kp SEMICOLON         &kp COLON             &kp SQT              &kp DOUBLE_QUOTES
&trans  &kp GRAVE        &kp TILDE     &kp BSLH        &kp PIPE          &kp AMPERSAND &kp QUESTION &kp COMMA            &kp DOT               &kp FSLH              &trans                &trans               &trans
                                               &trans  &trans           &trans         &trans      &trans                &trans
            >;
        };

        /*
         * Layer 6: DevNumRow (repurposes your old Music layer)
         * - Restores "number-row" muscle memory for coding:
         *   Left: 1 2 3 4 5  |  Right: 6 7 8 9 0
         * - Hold Shift on base (home-row shift) to get !@#$%^&*()
         * - Your existing layer-6 combos remain on this layer.
         */
        DevNumRow {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0     &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans     &trans
                         &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };
    };
};
